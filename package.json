{
  "name": "riwaq-design-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --experimental-strip-types --test tests/integration/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types prisma/seed.ts",
    "admin:create": "node --env-file-if-exists=.env --experimental-strip-types scripts/create-admin.ts",
    "maintenance": "node --env-file-if-exists=.env --experimental-strip-types scripts/maintenance.ts",
    "typecheck:foundation": "tsc --project tsconfig.foundation.json",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "lucide-react": "^0.468.0",
    "@prisma/client": "7.9.1",
    "zod": "3.25.76",
    "server-only": "^0.0.1",
    "@prisma/adapter-pg": "7.9.1",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "prisma": "7.9.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2"
  }
}
