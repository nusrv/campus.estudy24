# PostgreSQL, provisioned separately or through docker compose.
DATABASE_URL=postgresql://portal:CHANGE_ME@localhost:5432/portal?schema=public
APP_URL=http://localhost:3000
SITE_URL=https://campus.estudy24.com
# Generate independent secrets: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Optional: random 32+ character one-time browser setup authorization. Remove after setup.
ADMIN_BOOTSTRAP_TOKEN=
INGEST_API_KEY=
# Set true ONLY behind a trusted reverse proxy that OVERWRITES X-Forwarded-For.
TRUST_PROXY=false
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=5242880
# Safety gate for integration tests: a separate disposable DB with a name ending in _test.
TEST_DATABASE_URL=
