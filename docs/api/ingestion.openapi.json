{
  "openapi": "3.1.0",
  "info": {
    "title": "Campus eStudy24 — University ingestion",
    "version": "1.2.0",
    "description": "University-scoped ingestion. News defaults to pending_review; the owner may opt each university into quality-gated automatic news publication. Manual editorial/publication/deletion decisions are preserved. Structured links, events, calendar and programs always require review. Legacy server-wide keys remain supported on news endpoints only."
  },
  "servers": [
    {
      "url": "https://campus.estudy24.com"
    }
  ],
  "security": [
    {
      "UniversityKey": []
    }
  ],
  "paths": {
    "/api/ingest/articles": {
      "post": {
        "operationId": "ingestArticle",
        "summary": "إنشاء أو تحديث خبر واحد للمراجعة",
        "description": "1 MiB maximum JSON. Deduplicated by configured source plus original source_id. Scoped credentials require matching university_slug and source university. 60 requests/minute/key and client bucket.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Article"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Result"
          },
          "201": {
            "$ref": "#/components/responses/Result"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/RecordOrError"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/RecordOrError"
          }
        }
      }
    },
    "/api/ingest/batch": {
      "post": {
        "operationId": "ingestBatch",
        "summary": "استيراد دفعة من 1 إلى 50 خبرًا",
        "description": "1 MiB total. Per-record transactions. Check every results entry on HTTP 207. Mixed-university scoped batches are rejected before any import. Retry failed records with the same original IDs; fix rejected records first.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "articles"
                ],
                "properties": {
                  "articles": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "$ref": "#/components/schemas/Article"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Result"
          },
          "207": {
            "$ref": "#/components/responses/Result"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/RecordOrError"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/RecordOrError"
          }
        }
      }
    },
