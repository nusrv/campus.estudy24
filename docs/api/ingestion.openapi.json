  "components": {
    "securitySchemes": {
      "UniversityKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "campus_uak_ID.SECRET",
        "description": "Generate once in private university integration settings. Store in n8n Header Auth credentials. Never put keys in URLs or workflow exports. Owner sessions do not authenticate ingestion."
      }
    },
    "schemas": {
      "Url": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048,
        "pattern": "^https?://",
        "description": "HTTP(S) only; credentials in URLs are forbidden."
      },
      "Slug": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "Article": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "university_slug",
          "source_id",
          "source_url",
          "title"
        ],
        "properties": {
          "university_slug": {
            "$ref": "#/components/schemas/Slug"
          },
          "source_key": {
            "$ref": "#/components/schemas/Slug",
            "description": "Enabled configured source key; defaults to university_slug-rss. This is not a news record ID."
          },
          "source_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "description": "Stable original article ID. Reuse on retries and future source updates."
          },
          "source_url": {
            "$ref": "#/components/schemas/Url",
            "description": "Original article URL; hostname must match the configured source exactly."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "summary": {
            "type": "string",
            "maxLength": 5000,
            "default": ""
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "default": ""
          },
          "content_text": {
            "type": "string",
            "maxLength": 100000,
            "default": "",
            "description": "Plain text displayed escaped, never trusted HTML."
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "default": null,
            "description": "Original publication timestamp with timezone; not event or registration date."
          },
          "image_urls": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Url"
            },
            "default": []
          },
          "pdf_urls": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Url"
            },
            "default": []
          },
          "registration_links": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Url"
            },
            "default": []
          },
          "category": {
            "$ref": "#/components/schemas/Slug",
            "default": "general",
            "description": "News category slug. Approved: general, admissions, academic, training, opportunities, activities, research, student-services, announcements. Defaults to general. Existing administrator-registered custom categories remain supported. Unregistered unknown slugs return UNKNOWN_CATEGORY (422). Editorial category overrides and publication policies remain protected.",
            "examples": [
              "general",
              "admissions",
              "academic",
              "training",
              "opportunities",
              "activities",
              "research",
              "student-services",
              "announcements"
            ]
          }
        },
        "description": "External media URLs are attributed references, not automatically downloaded/rehosted. status, origin, university_id and administrator fields are forbidden. Missing optional fields default as documented; administrator-edited fields remain protected. Auto-publication requires owner opt-in, HTTPS source, title >=8 characters, summary or body >=40 characters, a supplied original publication timestamp within the last 366 days and no more than 5 minutes in the future, and no HTML/script/placeholder markup. Otherwise valid news stays in review. Malformed required fields are rejected. Existing manual decisions are never automatically republished."
      },
      "Outcome": {
        "type": "object",
        "required": [
          "index",
          "outcome"
        ],
        "properties": {
          "index": {
            "type": "integer"
          },
          "outcome": {
            "enum": [
              "created",
              "updated",
              "unchanged",
              "rejected",
              "failed"
            ]
          },
          "article_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "resource_id": {
            "type": "string"
          },
          "resource_type": {
            "enum": [
              "articles",
              "links",
              "events",
              "calendar",
              "programs",
              "academic-programs"
            ]
          },
          "publication": {
            "type": "object",
            "required": [
              "status",
              "decision"
            ],
            "properties": {
              "status": {
                "type": "string"
              },
              "decision": {
                "type": "string",
                "description": "Audited publication/review/manual-decision result."
              }
            }
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "request_id",
          "counts",
          "results"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "counts": {
            "type": "object",
            "required": [
              "created",
              "updated",
              "unchanged",
              "rejected",
              "failed"
            ],
            "properties": {
              "created": {
                "type": "integer"
              },
              "updated": {
                "type": "integer"
              },
              "unchanged": {
                "type": "integer"
              },
              "rejected": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Outcome"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "LinksInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "university_slug",
          "source_id",
          "source_url",
          "title",
          "destination_url",
          "kind"
        ],
        "properties": {
          "university_slug": {
            "$ref": "#/components/schemas/Slug"
          },
          "source_key": {
            "$ref": "#/components/schemas/Slug"
          },
          "source_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "description": "Stable original article ID. Reuse on retries and future source updates."
          },
          "source_url": {
            "$ref": "#/components/schemas/Url"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "default": ""
          },
          "destination_url": {
            "$ref": "#/components/schemas/Url"
          },
          "kind": {
            "enum": [
              "general",
              "official",
              "academic_calendar",
              "timetable",
              "student_service",
              "admission",
              "learning_resource"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/Slug",
            "default": "general"
          },
          "image_url": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Url"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "description": "Always pending_review on first import. Resource identity is source + content type + source_id. Later sync preserves manual fields, status, visibility and deletion. No inference from articles."
      },
      "EventsInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "university_slug",
          "source_id",
          "source_url",
          "title",
          "starts_at"
        ],
        "properties": {
          "university_slug": {
            "$ref": "#/components/schemas/Slug"
          },
          "source_key": {
            "$ref": "#/components/schemas/Slug"
          },
          "source_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "description": "Stable original article ID. Reuse on retries and future source updates."
          },
          "source_url": {
            "$ref": "#/components/schemas/Url"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "maxLength": 20000,
            "default": ""
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "description": "Explicit verified start/event/academic date. Never derive from article publication time."
          },
          "ends_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "If supplied must follow starts_at. Never invent a deadline."
          },
          "application_url": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Url"
              },
              {
                "type": "null"
              }
            ]
          },
