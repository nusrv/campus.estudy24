    {
      "id": "normalize",
      "name": "Validate Explicit Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(({json:r})=>{ if (/REPLACE_WITH_/.test(JSON.stringify(r))) throw new Error('Configure verified source records first; never infer services or dates from articles.'); if (!r.university_slug || !r.source_id || !r.source_url || !r.title) throw new Error('Explicit source identity is required.'); if (!r.destination_url || !r.kind) throw new Error('An explicit service URL and kind are required.'); return {json:{...r,source_id:String(r.source_id)}}; });"
      }
    },
    {
      "id": "http",
      "name": "Authenticated Campus Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
